---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { activeProfile } from "../../data/site";

const hasExperience = (activeProfile.experience?.length ?? 0) > 0;
const hasEducation = (activeProfile.education?.length ?? 0) > 0;
const hasPrimarySkills = (activeProfile.skills?.primary?.length ?? 0) > 0;
const hasTechnicalSkills = (activeProfile.skills?.technical?.length ?? 0) > 0;
---

<BaseLayout title={`CV | ${activeProfile.name}`} description={activeProfile.summary}>
  <section class="panel fx-slide-in">
    <div class="page-intro">
      <p class="eyebrow">CV // Profile</p>
      <h1>{activeProfile.name}</h1>
      <p>{activeProfile.title}</p>
      <p>{activeProfile.summary}</p>
    </div>
    <div class="cta-row">
      <a class="btn neon" href={activeProfile.contact.linkedin} target="_blank" rel="noreferrer" title="Open LinkedIn profile in new tab" aria-label="Visit LinkedIn profile">LinkedIn Profile</a>
      <a class="btn" href={activeProfile.contact.github} target="_blank" rel="noreferrer" title="Open GitHub profile in new tab" aria-label="Visit GitHub profile">GitHub Projects</a>
    </div>
  </section>

  <h2 class="section-title">Experience</h2>
  <section class="cards">
    {hasExperience ? (
      activeProfile.experience.map((job) => (
        <article class="card fx-slide-in">
          <h3>{job.position}</h3>
          <p>
            <strong>{job.company}</strong> · {job.period}
          </p>
          <p>{job.description}</p>
          {job.achievements?.length ? (
            <ul>
              {job.achievements.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : null}
          {job.technologies?.length ? (
            <div class="chip-list">
              {job.technologies.map((tech) => (
                <span class="chip">{tech}</span>
              ))}
            </div>
          ) : null}
        </article>
      ))
    ) : (
      <article class="card fx-slide-in">
        <h3>Experience is being updated</h3>
        <p>Profile data sync will populate this section with your latest roles and achievements.</p>
      </article>
    )}
  </section>

  <h2 class="section-title">Education</h2>
  <section class="cards">
    {hasEducation ? (
      activeProfile.education.map((edu) => (
        <article class="card fx-slide-in">
          <h3>{edu.degree}</h3>
          <p>
            <strong>{edu.school}</strong> · {edu.year}
          </p>
          <p>{edu.location}</p>
          {edu.description ? <p>{edu.description}</p> : null}
        </article>
      ))
    ) : (
      <article class="card fx-slide-in">
        <h3>Education details are being updated</h3>
        <p>This section will be auto-filled from your profile source.</p>
      </article>
    )}
  </section>

  <h2 class="section-title">Skills</h2>
  <section class="panel fx-slide-in">
    <h3>Core Competencies</h3>
    <div class="chip-list">
      {hasPrimarySkills ? activeProfile.skills.primary.map((skill) => <span class="chip">{skill}</span>) : <span class="chip">Updating</span>}
    </div>
    <h3>Technical Skills</h3>
    <div class="chip-list">
      {hasTechnicalSkills ? activeProfile.skills.technical.map((skill) => <span class="chip">{skill}</span>) : <span class="chip">Updating</span>}
    </div>
  </section>

  <h2 class="section-title">Certifications</h2>
  <section class="panel fx-slide-in">
    <div class="credly-badges">
      <div data-iframe-width="150" data-iframe-height="270" data-share-badge-id="b329f57a-c106-4b8e-805a-00771d99cbda" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="150" data-iframe-height="270" data-share-badge-id="2d909445-8309-40a6-8d9b-bfe2d0404dda" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="150" data-iframe-height="270" data-share-badge-id="e61a26e1-690a-41fe-b492-7873bcf50069" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="150" data-iframe-height="270" data-share-badge-id="7747ed32-17d0-4d3d-82e6-0e28ed30489c" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="150" data-iframe-height="270" data-share-badge-id="74e22579-0ab1-44f1-b478-cf8e543c9c06" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="150" data-iframe-height="270" data-share-badge-id="f2c599e3-e110-4084-b0ca-3ed8c192080f" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="150" data-iframe-height="270" data-share-badge-id="e516429c-55a5-4229-afe3-51e0c1407194" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="150" data-iframe-height="270" data-share-badge-id="e047fb12-dea1-46af-aad7-0e23189594a3" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="150" data-iframe-height="270" data-share-badge-id="b589993b-78fa-4008-8e41-05ef81fa2160" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="150" data-iframe-height="270" data-share-badge-id="54fd1204-aabd-460e-b14d-1f7803eabc62" data-share-badge-host="https://www.credly.com"></div>
    </div>
    <script async src="//cdn.credly.com/assets/utilities/embed.js"></script>
  </section>
</BaseLayout>

