---
import BaseLayout from "../layouts/BaseLayout.astro";
import NeonHero from "../components/NeonHero.jsx";
import GitHubActivity from "../components/GitHubActivity.jsx";
import ContributionGraph from "../components/ContributionGraph.jsx";
import { activeProfile } from "../data/site";
import { SITE_LOCATION, currentRole } from "../data/seo";
import { eventCountries, eventShortName, formatEventDates, pastEvents, speaking, upcomingEvents } from "../data/speaking";
import { activeCertifications, certificationCode } from "../data/credly";

const certNames = activeCertifications
  .map((badge) => {
    const code = certificationCode(badge.name);
    const full = badge.name.replace(/^[A-Z]{3,6}:\s*/, "").replace(/\s*\([^)]*\)$/, "");
    return code && !full.includes(code) ? `${full} (${code})` : full;
  })
  .slice(0, 4);

const pageTitle = `${activeProfile.name} – Cloud Native Engineer & Kubernetes Speaker`;
const pageDescription = `${activeProfile.name} – ${activeProfile.title}${currentRole ? ` at ${currentRole.company}` : ""} in ${SITE_LOCATION.locality}. Speaker on Kubernetes, Azure, GitOps & platform engineering.`;

const featuredEvents = [...upcomingEvents, ...pastEvents].slice(0, 3).map((event) => eventShortName(event.name));
const expertise = activeProfile.skills.primary.slice(0, 8);

const heroEvent = upcomingEvents[0] ?? pastEvents[0];
const heroTalk = heroEvent
  ? {
      name: eventShortName(heroEvent.name),
      dates: formatEventDates(heroEvent),
      endDate: heroEvent.end_date || heroEvent.start_date,
      upcoming: heroEvent === upcomingEvents[0],
      href: "/speaking/",
    }
  : null;
---

<BaseLayout title={pageTitle} description={pageDescription} pageType="ProfilePage">
  <NeonHero
    client:idle
    name={activeProfile.name}
    headline={activeProfile.headline}
    bio={activeProfile.bio}
    talk={heroTalk}
    linkedinUrl={activeProfile.contact.linkedin}
    githubUrl={activeProfile.contact.github}
    sessionizeUrl={activeProfile.contact.sessionize}
    metrics={activeProfile.metrics}
    avatarUrl={activeProfile.avatar_url}
  />

  <section class="section-title" aria-labelledby="about-heading">
    <p class="eyebrow">About // Profile</p>
    <h2 id="about-heading">About Me</h2>
    <div class="panel fx-slide-in about-panel">
      <p class="about-lede">{activeProfile.summary}</p>
      {featuredEvents.length > 0 && (
        <p>
          I speak about Kubernetes, GitOps and platform engineering at conferences across Europe – including{" "}
          {featuredEvents.slice(0, -1).join(", ")}{featuredEvents.length > 1 ? " and " : ""}{featuredEvents[featuredEvents.length - 1]}.{" "}
          <a href="/speaking/">See all {speaking.events.length} conference talks in {eventCountries.length} countries</a>.
        </p>
      )}
      {certNames.length > 0 && (
        <p>
          Certifications include {certNames.slice(0, -1).join(", ")}{certNames.length > 1 ? " and " : ""}{certNames[certNames.length - 1]}.{" "}
          <a href="/cv/#certifications">View certifications</a>.
        </p>
      )}
      {activeProfile.current_focus.length > 0 && (
        <>
          <h3>Current focus</h3>
          <ul class="focus-list">
            {activeProfile.current_focus.map((item) => <li>{item}</li>)}
          </ul>
        </>
      )}
      {expertise.length > 0 && (
        <ul class="chip-list" aria-label="Areas of expertise">
          {expertise.map((skill) => <li class="chip">{skill}</li>)}
        </ul>
      )}
      <p class="about-more"><a href="/cv/">Read the full CV →</a></p>
    </div>
  </section>
  <section class="section-title">
    <p class="eyebrow">Explore // Site</p>
    <h2>Where to Next</h2>
    <div class="cards">
      {[
        { href: "/cv/", tag: "01", title: "Professional CV", text: "Career history, achievements, and technical strengths.", cta: "Read the CV" },
        { href: "/speaking/", tag: "02", title: "Speaking", text: "Conference sessions, topics, and event updates from Sessionize.", cta: "See talks" },
        { href: "/socials/", tag: "03", title: "Socials", text: "Direct links for collaboration, networking, and OSS discussions.", cta: "Get in touch" },
      ].map((item) => (
        <a class="card nav-card fx-slide-in" href={item.href}>
          <span class="card-tag" aria-hidden="true">{item.tag}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <span class="card-cta" aria-hidden="true">
            {item.cta}
            <svg viewBox="0 0 24 24" width="16" height="16" focusable="false"><path fill="currentColor" d="M5 11h11.2l-4.6-4.6L13 5l7 7-7 7-1.4-1.4 4.6-4.6H5v-2Z" /></svg>
          </span>
        </a>
      ))}    </div>
  </section>

  <section class="section-title">
    <p class="eyebrow">GitHub // Activity</p>
    <h2>Recent GitHub Activity</h2>
    <div class="panel fx-slide-in cg-panel">
      <ContributionGraph client:idle githubUrl={activeProfile.contact.github} />
    </div>
    <div style="margin-top: 1rem;">
      <GitHubActivity client:idle githubUrl={activeProfile.contact.github} />
    </div>
  </section>

  <section class="section-title connect-section">
    <div class="connect-header" data-reveal>
      <div>
        <p class="eyebrow">Social // Connect</p>
        <h2>Let's Connect</h2>
        <p class="connect-lede">Recent updates straight from LinkedIn, plus the fastest ways to reach me.</p>
      </div>
      <a
        class="btn neon li-connect-btn"
        href={activeProfile.contact.linkedin}
        target="_blank"
        rel="noreferrer"
        title="Open LinkedIn profile in new tab"
        aria-label="Connect on LinkedIn"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.27 2.38 4.27 5.47v6.27ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z" />
        </svg>
        Connect on LinkedIn
      </a>
    </div>

    {(() => {
      const bufferPosts = activeProfile.buffer_posts ?? [];
      const linkedinPosts = activeProfile.linkedin_posts ?? [];
      const posts = bufferPosts.length > 0 ? bufferPosts : linkedinPosts;
      return posts.length > 0 ? (
        <div class="li-posts-grid">
          {posts.slice(0, 3).map((post) => {
            const service = ((post as { service?: string }).service ?? "").toLowerCase();
            const serviceLabels: { [key: string]: string } = {
              linkedin: "LinkedIn",
              twitter: "X",
              x: "X",
              mastodon: "Mastodon",
              instagram: "Instagram",
              facebook: "Facebook",
            };
            const fallbackLabel = service ? service.charAt(0).toUpperCase() + service.slice(1) : "LinkedIn";
            const label = (serviceLabels[service] ?? fallbackLabel) + " post";
            return (
              <a
                class="li-post-card fx-slide-in"
                href={post.url}
                target="_blank"
                rel="noreferrer"
                title={`Read ${label} in new tab`}
              >
                <span class="li-post-badge">
                  <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.27 2.38 4.27 5.47v6.27ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z" />
                  </svg>
                  {label}
                </span>
                <p class="li-post-text">{post.text}</p>
                <div class="li-post-footer">
                  <span class="li-post-date">
                    {post.published_at ? new Date(post.published_at).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }) : "Recent"}
                  </span>
                  <span class="li-post-cta">Read post →</span>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        /* Profile card — shown until Buffer/Proxycurl syncs posts */
        <div class="panel fx-slide-in li-profile-card">
          <div class="li-profile-left">
            <img
              class="li-avatar"
              src={activeProfile.avatar_url}
              alt={`${activeProfile.name} profile picture`}
              width="72"
              height="72"
            />
            <div>
              <p class="li-name">{activeProfile.name}</p>
              <p class="li-title">{activeProfile.title}</p>
            </div>
          </div>
          <p class="li-summary">{activeProfile.bio}</p>
          <div class="cta-row">
            <a
              class="btn"
              href={activeProfile.contact.github}
              target="_blank"
              rel="noreferrer"
              title="Open GitHub profile in new tab"
              aria-label="View GitHub"
            >
              View GitHub
            </a>
          </div>
        </div>
      );
    })()}
  </section>
</BaseLayout>

