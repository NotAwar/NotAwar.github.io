---
import { formatMonth, isExpired, type CredlyBadge } from "../data/credly";
import { optimizeRemoteImage } from "../lib/remote-image";

interface Props {
  badge: CredlyBadge;
}

const { badge } = Astro.props;
const expired = isExpired(badge);
// Credly originals are 600–2048px PNGs (up to 1 MB); serve 88px WebP instead
const image = badge.image ? await optimizeRemoteImage(badge.image, 88) : undefined;
---

<li class:list={["badge-item", { "is-expired": expired }]} data-reveal>
  <a class="badge-link" href={badge.url} target="_blank" rel="noopener noreferrer">
    {image && (
      <img src={image.src} srcset={image.srcset} width="88" height="88" alt="" loading="lazy" decoding="async" />
    )}
    <span class="badge-body">
      <span class="badge-name">{badge.name}</span>
      <span class="badge-meta">
        {badge.issuer}{badge.issued_on && <>{"\u00a0· "}<time datetime={badge.issued_on}>{formatMonth(badge.issued_on)}</time></>}
      </span>
      {badge.expires_on && (
        <span class="badge-status">
          {expired ? "Expired" : "Valid until"} <time datetime={badge.expires_on}>{formatMonth(badge.expires_on)}</time>
        </span>
      )}
    </span>
    <span class="sr-only"> (opens Credly verification in a new tab)</span>
  </a>
</li>
