---
// Spin and pulse are CSS keyframes (global.css), so no animation runtime ships
interface Props {
  size?: number;
}

const { size = 200 } = Astro.props;
const TICK_COUNT = 48;
const CENTER = 110;
const ticks = Array.from({ length: TICK_COUNT }, (_, i) => (360 / TICK_COUNT) * i);
---

<svg
  class="radar-ring"
  viewBox="0 0 220 220"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <g class="radar-ticks">
    {ticks.map((angle) => (
      <line class="radar-tick" x1={CENTER} y1="4" x2={CENTER} y2="12" transform={`rotate(${angle} ${CENTER} ${CENTER})`} />
    ))}
  </g>
  <g class="radar-arc radar-arc-1">
    <circle cx={CENTER} cy={CENTER} r="98" pathLength="100" stroke-dasharray="22 78" />
    <circle class="radar-node" cx={CENTER} cy="12" r="3" />
  </g>
  <g class="radar-arc radar-arc-2">
    <circle cx={CENTER} cy={CENTER} r="84" pathLength="100" stroke-dasharray="16 84" />
    <circle class="radar-node radar-node-alt" cx={CENTER} cy="26" r="2.5" />
  </g>
  <circle class="radar-core" cx={CENTER} cy={CENTER} r="7" />
</svg>
