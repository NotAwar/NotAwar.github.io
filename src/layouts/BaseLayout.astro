---
import "../styles/global.css";
import { navigation, activeProfile } from "../data/site";

const { title = "Awar Abdulkarim", description = activeProfile.bio } = Astro.props;
const pagePath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={activeProfile.name} />
    <meta name="theme-color" content="#0b0b0b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/images/og-image.svg" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/assets/images/og-image.svg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&display=swap"
      rel="stylesheet"
    />
    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var preferred = stored || (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
          if (preferred === "light") document.documentElement.setAttribute("data-theme", "light");
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <div class="bg-manga"></div>
    <header class="site-shell">
      <a class="brand" href="/">AWAR//SYS</a>
      <nav>
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a href={item.link} class={pagePath === item.link ? "active" : ""}>
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle light/dark mode" title="Toggle light/dark mode">
        <!-- icon and label injected by script below -->
      </button>
    </header>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;

        var sunIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V5a1 1 0 0 1 1-1zm0 13a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1zm8-5a1 1 0 0 1-1 1h-1a1 1 0 1 1 0-2h1a1 1 0 0 1 1 1zM5 12a1 1 0 0 1-1 1H3a1 1 0 1 1 0-2h1a1 1 0 0 1 1 1zm12.657-6.243a1 1 0 0 1 0 1.414l-.707.707a1 1 0 1 1-1.414-1.414l.707-.707a1 1 0 0 1 1.414 0zM7.05 16.95a1 1 0 0 1 0 1.414l-.707.707a1 1 0 1 1-1.414-1.414l.707-.707A1 1 0 0 1 7.05 16.95zm9.9 0a1 1 0 0 1 1.414 0l.707.707a1 1 0 1 1-1.414 1.414l-.707-.707a1 1 0 0 1 0-1.414zM7.05 7.05a1 1 0 0 1-1.414 0l-.707-.707A1 1 0 0 1 6.343 4.93l.707.707a1 1 0 0 1 0 1.414zM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"/></svg>';
        var moonIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/></svg>';

        function getTheme() {
          return document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
        }

        function applyTheme(theme) {
          if (theme === "light") {
            document.documentElement.setAttribute("data-theme", "light");
            btn.innerHTML = moonIcon + "<span>Dark</span>";
          } else {
            document.documentElement.removeAttribute("data-theme");
            btn.innerHTML = sunIcon + "<span>Light</span>";
          }
          try { localStorage.setItem("theme", theme); } catch (_) {}
        }

        // Set initial button state
        applyTheme(getTheme());

        btn.addEventListener("click", function () {
          applyTheme(getTheme() === "light" ? "dark" : "light");
        });
      })();
    </script>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {activeProfile.name}</p>
      <div class="footer-links">
        <a href={activeProfile.contact.github} target="_blank" rel="noreferrer" title="Open GitHub in new tab" aria-label="Visit GitHub">GitHub</a>
        <a href={activeProfile.contact.linkedin} target="_blank" rel="noreferrer" title="Open LinkedIn in new tab" aria-label="Visit LinkedIn">LinkedIn</a>
        <a href={activeProfile.contact.sessionize} target="_blank" rel="noreferrer" title="Open Sessionize in new tab" aria-label="Visit Sessionize">Sessionize</a>
      </div>
    </footer>
  </body>
</html>

