# LinkedIn Profile Sync Configuration
#
# Optional: Proxycurl API key for automatic LinkedIn profile syncing
# Get your API key at: https://nubela.co/proxycurl/
# Without this key, the sync script will use existing profile data
PROXYCURL_API_KEY=your-api-key-here

# Optional: LinkedIn profile URL to sync from (defaults to notawar)
# Example: https://www.linkedin.com/in/your-profile-name
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/notawar
